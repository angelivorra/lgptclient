    {
      "label": "Sinte: arrancar (venv + dependencias)",
      "type": "shell",
      "command": "test -d .venv || { python3 -m venv .venv && .venv/bin/pip install -r requirements.txt; }; .venv/bin/python lgpt_player.py --device default",
      "options": {
        "cwd": "${workspaceFolder}/sinte"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
