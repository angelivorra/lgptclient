{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Stop sinte player (tty1)",
      "type": "shell",
      "command": "sudo systemctl stop getty@tty1.service",
      "problemMatcher": []
    },
    {
      "label": "Start sinte player (tty1)",
      "type": "shell",
      "command": "sudo systemctl start getty@tty1.service",
      "problemMatcher": []
    },
    {
      "label": "Restart sinte player (tty1)",
      "type": "shell",
      "command": "sudo systemctl restart getty@tty1.service",
      "problemMatcher": []
    },
    {
      "label": "LGPT",
      "type": "shell",
      "command": "/home/angel/LGPT/bin/lgpt.x64",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "MIDI Monitor (tkinter)",
      "type": "shell",
      "command": "${workspaceFolder}/midi_monitor/venv/bin/python ${workspaceFolder}/midi_monitor/main.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "MIDI Monitor Linux (Kirigami)",
