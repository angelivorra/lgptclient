#:kivy 2.0

# Layout del mixer: tema oscuro tipo mesa de directo (grises oscuros,
# acentos verde/ámbar). Toda la UI en español. Los handlers llaman a
# métodos de MixerApp, que encolan llamadas al backend (engine de sinte
# en este proceso) en el hilo trabajador.
# La zona inferior imita al LPD8: pads a la izquierda en dos filas (los 4
# de la izquierda son transporte: anterior/siguiente/play/stop; los otros
# 4 disparan los WAV de sinte/wavs) y knobs a la derecha en dos filas.
# El Knob se dibuja en Python (ver main.py), aquí no lleva canvas.

<ChannelStrip>:
    orientation: "vertical"
    padding: 3
    spacing: 2
    canvas.before:
        Color:
            rgba: 0.14, 0.14, 0.16, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.26, 0.26, 0.29, 1
        Line:
            width: 1
            rectangle: [self.x, self.y, self.width, self.height]
    Label:
        text: "CH " + str(root.canal + 1)
        size_hint_y: None
        height: 18
        bold: True
        color: 0.85, 0.85, 0.85, 1
    Label:
        text: "pos " + root.posicion
        size_hint_y: None
        height: 13
        font_size: '10sp'
        color: 0.55, 0.55, 0.6, 1
    BoxLayout:
        size_hint_y: None
        height: 26
        spacing: 2
        ToggleButton:
            text: "M"
            state: "down" if root.mute else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.8, 0.25, 0.2, 1) if self.state == "down" else (0.25, 0.25, 0.28, 1)
            on_state: app.on_mute(root.canal, self.state == "down")
        ToggleButton:
            text: "V"
            state: "down" if root.voc else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.85, 0.6, 0.12, 1) if self.state == "down" else (0.25, 0.25, 0.28, 1)
            on_state: app.on_vocoder(root.canal, self.state == "down")
        ToggleButton:
            text: "P"
            state: "down" if root.pres else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.75, 0.35, 1) if self.state == "down" else (0.25, 0.25, 0.28, 1)
            on_state: app.on_presence(root.canal, self.state == "down")
    # sliders de efectos: se construyen en Python desde EFFECT_PRESETS
    # (MixerApp._construir_fx), así un efecto nuevo del player aparece solo
    BoxLayout:
        id: fx_box
        spacing: 1

<KnobWidget>:
    orientation: "vertical"
    spacing: 2
    Label:
        text: "Knob " + str(root.knob_n)
        size_hint_y: None
        height: 16
        bold: True
        font_size: '12sp'
        color: 0.85, 0.85, 0.85, 1
    Knob:
        id: knob
        modo: root.modo
        on_value: app.on_knob(root.knob_n, int(self.value))
    Label:
        text: str(int(knob.value))
        size_hint_y: None
        height: 13
        font_size: '10sp'
        color: 0.6, 0.6, 0.65, 1
    # qué aplica el knob: off / red / efecto o parámetro (valores los
    # rellena la app con la lista viva de efectos del engine)
    Spinner:
        id: param_spinner
        text: root.param
        values: ["off", "red"]
        size_hint_y: None
        height: 24
        font_size: '11sp'
        background_normal: ""
        background_color: 0.2, 0.2, 0.23, 1
        on_text: app.on_knob_param(root.knob_n, self.text)
    # a qué canales afecta (1-8)
    GridLayout:
        cols: 8
        size_hint_y: None
        height: 22
        spacing: 1
        ToggleButton:
            text: "1"
            font_size: '10sp'
            state: "down" if 0 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_state: app.on_knob_canal(root.knob_n, 0, self.state == "down")
        ToggleButton:
            text: "2"
            font_size: '10sp'
            state: "down" if 1 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_state: app.on_knob_canal(root.knob_n, 1, self.state == "down")
        ToggleButton:
            text: "3"
            font_size: '10sp'
            state: "down" if 2 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_state: app.on_knob_canal(root.knob_n, 2, self.state == "down")
        ToggleButton:
            text: "4"
            font_size: '10sp'
            state: "down" if 3 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_state: app.on_knob_canal(root.knob_n, 3, self.state == "down")
        ToggleButton:
            text: "5"
            font_size: '10sp'
            state: "down" if 4 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_state: app.on_knob_canal(root.knob_n, 4, self.state == "down")
        ToggleButton:
            text: "6"
            font_size: '10sp'
            state: "down" if 5 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_state: app.on_knob_canal(root.knob_n, 5, self.state == "down")
        ToggleButton:
            text: "7"
            font_size: '10sp'
            state: "down" if 6 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_state: app.on_knob_canal(root.knob_n, 6, self.state == "down")
        ToggleButton:
            text: "8"
            font_size: '10sp'
            state: "down" if 7 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_state: app.on_knob_canal(root.knob_n, 7, self.state == "down")

<PadTransporte@Button>:
    font_size: '14sp'
    bold: True
    background_normal: ""
    background_color: 0.24, 0.24, 0.28, 1

<PadWav@Button>:
    n: 1
    text: "WAV " + str(self.n)
    font_size: '14sp'
    bold: True
    background_normal: ""
    disabled: self.n > app.pads_count
    background_color: (0.2, 0.45, 0.3, 1) if not self.disabled else (0.16, 0.16, 0.18, 1)
    on_release: app.pad(self.n)

<MixerRoot>:
    orientation: "vertical"
    padding: 6
    spacing: 6
    canvas.before:
        Color:
            rgba: 0.09, 0.09, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # -- barra superior: título, canciones y transporte ----------------------
    BoxLayout:
        size_hint_y: None
        height: 40
        spacing: 6
        Label:
            text: "ROBOTRACA MIXER"
            size_hint_x: None
            width: 200
            bold: True
            font_size: '16sp'
            color: 0.5, 0.9, 0.55, 1
        Spinner:
            id: spinner_canciones
            text: "— canciones —"
            background_color: 0.25, 0.25, 0.28, 1
            on_text: app.seleccionar_cancion(self.text)
        Button:
            text: "Play"
            size_hint_x: None
            width: 65
            background_color: 0.2, 0.5, 0.3, 1
            on_release: app.play()
        Button:
            text: "Pausa"
            size_hint_x: None
            width: 65
            background_color: 0.65, 0.5, 0.12, 1
            on_release: app.pause()
        Button:
            text: "Stop"
            size_hint_x: None
            width: 65
            background_color: 0.55, 0.2, 0.2, 1
            on_release: app.stop()
        Label:
            id: lbl_playing
            text: "PARADA"
            size_hint_x: None
            width: 110
            bold: True
            font_size: '15sp'
            color: 0.55, 0.55, 0.6, 1
        Label:
            id: lbl_bpm
            text: "BPM: —"
            size_hint_x: None
            width: 95
            color: 0.5, 0.9, 0.55, 1
        Label:
            id: lbl_activos
            text: "Activos: —"
            size_hint_x: None
            width: 85
            color: 0.5, 0.9, 0.55, 1

    # -- fila central: 8 channel strips --------------------------------------
    BoxLayout:
        id: strips
        spacing: 4
        ChannelStrip:
            canal: 0
        ChannelStrip:
            canal: 1
        ChannelStrip:
            canal: 2
        ChannelStrip:
            canal: 3
        ChannelStrip:
            canal: 4
        ChannelStrip:
            canal: 5
        ChannelStrip:
            canal: 6
        ChannelStrip:
            canal: 7

    # -- zona inferior: pads (izquierda) y knobs (derecha), dos filas -------
    BoxLayout:
        size_hint_y: None
        height: 400
        spacing: 6

        # Pads 2x4: los 4 de la izquierda son transporte (como los botones
        # del player), los 4 de la derecha disparan los WAV de sinte/wavs
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: 420
            spacing: 2
            Label:
                text: "PADS"
                size_hint_y: None
                height: 16
                font_size: '11sp'
                bold: True
                color: 0.55, 0.55, 0.6, 1
            GridLayout:
                cols: 4
                spacing: 4
                padding: 2
                PadTransporte:
                    text: "|< ANT"
                    background_color: 0.25, 0.3, 0.45, 1
                    on_release: app.pad_anterior()
                PadTransporte:
                    text: "SIG >|"
                    background_color: 0.25, 0.3, 0.45, 1
                    on_release: app.pad_siguiente()
                PadWav:
                    n: 1
                PadWav:
                    n: 2
                PadTransporte:
                    text: "> PLAY"
                    background_color: 0.2, 0.5, 0.3, 1
                    on_release: app.pad_play()
                PadTransporte:
                    text: "[] STOP"
                    background_color: 0.55, 0.2, 0.2, 1
                    on_release: app.pad_stop()
                PadWav:
                    n: 3
                PadWav:
                    n: 4

        # Knobs 2x4
        BoxLayout:
            orientation: "vertical"
            spacing: 2
            Label:
                text: "KNOBS"
                size_hint_y: None
                height: 16
                font_size: '11sp'
                bold: True
                color: 0.55, 0.55, 0.6, 1
            GridLayout:
                id: knobs
                cols: 4
                spacing: 4
                padding: 2
                KnobWidget:
                    knob_n: 1
                KnobWidget:
                    knob_n: 2
                KnobWidget:
                    knob_n: 3
                KnobWidget:
                    knob_n: 4
                KnobWidget:
                    knob_n: 5
                KnobWidget:
                    knob_n: 6
                KnobWidget:
                    knob_n: 7
                KnobWidget:
                    knob_n: 8

    # -- barra inferior: master, guardar/recargar y estado -------------------
    BoxLayout:
        size_hint_y: None
        height: 46
        spacing: 8
        Label:
            text: "Master"
            size_hint_x: None
            width: 60
            color: 0.8, 0.8, 0.8, 1
        ReleaseSlider:
            id: master
            min: 0
            max: 200
            value: 100
            on_release: app.on_master(int(self.value))
        Label:
            id: lbl_master
            text: str(int(master.value)) + "%"
            size_hint_x: None
            width: 50
            color: 0.5, 0.9, 0.55, 1
        Button:
            text: "Guardar"
            size_hint_x: None
            width: 100
            background_color: 0.2, 0.5, 0.3, 1
            on_release: app.guardar()
        Button:
            text: "Recargar"
            size_hint_x: None
            width: 100
            background_color: 0.25, 0.25, 0.28, 1
            on_release: app.recargar()
        Label:
            id: lbl_estado
            text: ""
            color: 0.75, 0.75, 0.75, 1
            halign: "left"
            valign: "middle"
            text_size: self.size
