#:kivy 2.0

# Layout del mixer: tema oscuro tipo mesa de directo (grises oscuros,
# acentos verde/ámbar). Toda la UI en español. Los handlers llaman a
# métodos de MixerApp, que encolan llamadas al backend (engine de sinte
# en este proceso) en el hilo trabajador.
# Sin interacción en vivo duplicada: el transporte (up/down/play/stop) y
# el disparo de los pads de WAV los hace el controlador MIDI físico,
# igual que en el player real (ver MixerApp._bucle/_boton_fisico). Los
# knobs también se giran en el controlador; aquí solo se configura a qué
# canal/efecto apunta cada uno en la canción (persiste en "pots" del
# robotraca.json), igual que los pads solo configuran aquí QUÉ wav suena
# en cada uno (banco global wavs/pads.json, no por canción — ver
# MixerBackend.assign_pad). El osciloscopio de mezcla se dibuja en Python
# (ver main.py), aquí no lleva canvas propio.

<ChannelStrip>:
    orientation: "vertical"
    padding: 3
    spacing: 2
    canvas.before:
        Color:
            rgba: 0.14, 0.14, 0.16, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.26, 0.26, 0.29, 1
        Line:
            width: 1
            rectangle: [self.x, self.y, self.width, self.height]
    Label:
        text: "CH " + str(root.canal + 1)
        size_hint_y: None
        height: 18
        bold: True
        color: 0.85, 0.85, 0.85, 1
    Label:
        text: "pos " + root.posicion
        size_hint_y: None
        height: 13
        font_size: '10sp'
        color: 0.55, 0.55, 0.6, 1
    BoxLayout:
        size_hint_y: None
        height: 26
        spacing: 2
        ToggleButton:
            text: "M"
            state: "down" if root.mute else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.8, 0.25, 0.2, 1) if self.state == "down" else (0.25, 0.25, 0.28, 1)
            on_state: app.on_mute(root.canal, self.state == "down")
        ToggleButton:
            text: "V"
            state: "down" if root.voc else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.85, 0.6, 0.12, 1) if self.state == "down" else (0.25, 0.25, 0.28, 1)
            on_state: app.on_vocoder(root.canal, self.state == "down")
        ToggleButton:
            text: "P"
            state: "down" if root.pres else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.75, 0.35, 1) if self.state == "down" else (0.25, 0.25, 0.28, 1)
            on_state: app.on_presence(root.canal, self.state == "down")

<KnobWidget>:
    orientation: "vertical"
    spacing: 2
    Label:
        text: "Knob " + str(root.knob_n)
        size_hint_y: None
        height: 16
        bold: True
        font_size: '12sp'
        color: 0.85, 0.85, 0.85, 1
    # Solo configuración: a qué apunta este pot físico en la canción
    # (off / red / efecto o parámetro). El valor en vivo lo pone el knob
    # físico directamente sobre el engine; el color indica el modo
    # resultante (gris=off, ámbar=red, verde=target).
    Spinner:
        id: param_spinner
        text: root.param
        values: ["off", "red"]
        size_hint_y: None
        height: 26
        font_size: '11sp'
        background_normal: ""
        background_color: (0.3, 0.75, 0.35, 1) if root.modo == "target" else ((0.85, 0.6, 0.12, 1) if root.modo == "red" else (0.2, 0.2, 0.23, 1))
        on_text: app.on_knob_param(root.knob_n, self.text)
    # a qué canales afecta (1-8)
    GridLayout:
        cols: 8
        size_hint_y: None
        height: 22
        spacing: 1
        ToggleButton:
            text: "1"
            font_size: '10sp'
            state: "down" if 0 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            # on_release (no on_state): al recargar la canción Kivy dispara
            # on_state al pintar los toggles y reescribía el canal viejo.
            on_release: app.on_knob_canal(root.knob_n, 0, self.state == "down")
        ToggleButton:
            text: "2"
            font_size: '10sp'
            state: "down" if 1 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_release: app.on_knob_canal(root.knob_n, 1, self.state == "down")
        ToggleButton:
            text: "3"
            font_size: '10sp'
            state: "down" if 2 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_release: app.on_knob_canal(root.knob_n, 2, self.state == "down")
        ToggleButton:
            text: "4"
            font_size: '10sp'
            state: "down" if 3 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_release: app.on_knob_canal(root.knob_n, 3, self.state == "down")
        ToggleButton:
            text: "5"
            font_size: '10sp'
            state: "down" if 4 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_release: app.on_knob_canal(root.knob_n, 4, self.state == "down")
        ToggleButton:
            text: "6"
            font_size: '10sp'
            state: "down" if 5 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_release: app.on_knob_canal(root.knob_n, 5, self.state == "down")
        ToggleButton:
            text: "7"
            font_size: '10sp'
            state: "down" if 6 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_release: app.on_knob_canal(root.knob_n, 6, self.state == "down")
        ToggleButton:
            text: "8"
            font_size: '10sp'
            state: "down" if 7 in root.canales else "normal"
            background_normal: ""
            background_down: ""
            background_color: (0.3, 0.55, 0.8, 1) if self.state == "down" else (0.22, 0.22, 0.25, 1)
            on_release: app.on_knob_canal(root.knob_n, 7, self.state == "down")
    # mezcla dry/wet del efecto (0-100%, 100 = igual que sin esto): solo
    # tiene sentido si el knob apunta a un efecto (no off/red/tempo/...)
    BoxLayout:
        size_hint_y: None
        height: 20 if root.param in app._efectos else 0
        opacity: 1 if root.param in app._efectos else 0
        disabled: root.param not in app._efectos
        spacing: 4
        ReleaseSlider:
            id: mix_slider
            min: 0
            max: 100
            value: root.mix
            on_release: app.on_knob_mix(root.knob_n, int(self.value))
        Label:
            text: "mix " + str(int(mix_slider.value)) + "%"
            size_hint_x: None
            width: 56
            font_size: '9sp'

<PadAssignWidget>:
    orientation: "vertical"
    spacing: 2
    Label:
        text: "Pad " + str(root.pad_n)
        size_hint_y: None
        height: 16
        bold: True
        font_size: '12sp'
        color: 0.85, 0.85, 0.85, 1
    # qué WAV suena en este pad (banco global wavs/pads.json, ver
    # MixerBackend.assign_pad); un solo botón abre un desplegable en árbol
    # (MixerApp.on_pad_open) donde las subcarpetas como wavs/candidatos2 se
    # expanden inline en vez de mezclarse en una lista plana.
    Button:
        id: wav_button
        text: root.wav
        size_hint_y: None
        height: 26
        font_size: '10sp'
        background_normal: ""
        background_color: 0.2, 0.2, 0.23, 1
        on_release: app.on_pad_open(root.pad_n, self)
    # volumen de este pad (0-100%), por canción (robotraca.json
    # "pad_volume"; ver MixerBackend.set_pad_volume)
    BoxLayout:
        size_hint_y: None
        height: 20
        spacing: 4
        ReleaseSlider:
            id: vol_slider
            min: 0
            max: 100
            value: root.vol
            on_release: app.on_pad_volume(root.pad_n, int(self.value))
        Label:
            text: str(int(vol_slider.value)) + "%"
            size_hint_x: None
            width: 34
            font_size: '9sp'
            color: 0.6, 0.6, 0.65, 1

<MixerRoot>:
    orientation: "vertical"
    padding: 6
    spacing: 6
    canvas.before:
        Color:
            rgba: 0.09, 0.09, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # -- barra superior: título, canciones y estado de transporte ------------
    # Sin botones Play/Pausa/Stop: el transporte lo maneja el controlador
    # MIDI físico (up/down/play/stop), igual que en el player real.
    BoxLayout:
        size_hint_y: None
        height: 40
        spacing: 6
        Label:
            text: "ROBOTRACA MIXER"
            size_hint_x: None
            width: 200
            bold: True
            font_size: '16sp'
            color: 0.5, 0.9, 0.55, 1
        Spinner:
            id: spinner_canciones
            text: "— canciones —"
            background_color: 0.25, 0.25, 0.28, 1
            on_text: app.seleccionar_cancion(self.text)
        Label:
            id: lbl_playing
            text: "PARADA"
            size_hint_x: None
            width: 110
            bold: True
            font_size: '15sp'
            color: 0.55, 0.55, 0.6, 1
        Label:
            id: lbl_bpm
            text: "BPM: —"
            size_hint_x: None
            width: 95
            color: 0.5, 0.9, 0.55, 1
        Label:
            id: lbl_activos
            text: "Activos: —"
            size_hint_x: None
            width: 85
            color: 0.5, 0.9, 0.55, 1

    # -- traer/actualizar canciones desde la carpeta de trabajo de LGPT -----
    # (importa-cancion.sh: copia lgptsav.dat y samples, conserva el
    # robotraca.json de cada canción; ver MixerBackend.import_song).
    BoxLayout:
        size_hint_y: None
        height: 32
        spacing: 6
        Label:
            text: "LGPT:"
            size_hint_x: None
            width: 45
            color: 0.55, 0.55, 0.6, 1
        Spinner:
            id: spinner_origen
            text: "— origen —"
            background_color: 0.25, 0.25, 0.28, 1
        Button:
            text: "Importar/Actualizar"
            size_hint_x: None
            width: 160
            background_color: 0.2, 0.5, 0.3, 1
            on_release: app.importar_cancion()
        Button:
            text: "Actualizar todas"
            size_hint_x: None
            width: 130
            background_color: 0.25, 0.25, 0.28, 1
            on_release: app.actualizar_todas()

    # -- fila central: 8 channel strips (altura fija: solo nombre/pos/M-V-P) --
    BoxLayout:
        id: strips
        size_hint_y: None
        height: 90
        spacing: 4
        ChannelStrip:
            canal: 0
        ChannelStrip:
            canal: 1
        ChannelStrip:
            canal: 2
        ChannelStrip:
            canal: 3
        ChannelStrip:
            canal: 4
        ChannelStrip:
            canal: 5
        ChannelStrip:
            canal: 6
        ChannelStrip:
            canal: 7

    # -- osciloscopio de la mezcla final (ocupa el hueco que dejan los strips) -
    BoxLayout:
        size_hint_y: 1
        spacing: 6
        Label:
            text: "MEZCLA"
            size_hint_x: None
            width: 70
            font_size: '11sp'
            bold: True
            color: 0.55, 0.55, 0.6, 1
        MixScope:
            id: scope

    # -- zona inferior: solo configuración (qué WAV por pad, target por --
    # -- knob); el valor/disparo en vivo los hace el controlador físico --
    BoxLayout:
        size_hint_y: None
        height: 170
        spacing: 6

        # Qué WAV suena en cada uno de los 4 pads (banco global, ver
        # MixerBackend.assign_pad); el disparo en vivo lo hace el pad
        # físico (sample1-4 en el TOML), no hay botón aquí.
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: 260
            spacing: 2
            Label:
                text: "PADS (qué WAV y volumen)"
                size_hint_y: None
                height: 16
                font_size: '11sp'
                bold: True
                color: 0.55, 0.55, 0.6, 1
            GridLayout:
                id: pads
                cols: 2
                spacing: 4
                padding: 2
                PadAssignWidget:
                    pad_n: 1
                PadAssignWidget:
                    pad_n: 2
                PadAssignWidget:
                    pad_n: 3
                PadAssignWidget:
                    pad_n: 4

        BoxLayout:
            orientation: "vertical"
            spacing: 2
            Label:
                text: "KNOBS (target por canción; el valor en vivo lo pone el controlador físico)"
                size_hint_y: None
                height: 16
                font_size: '11sp'
                bold: True
                color: 0.55, 0.55, 0.6, 1
            GridLayout:
                id: knobs
                cols: 4
                spacing: 4
                padding: 2
                KnobWidget:
                    knob_n: 1
                KnobWidget:
                    knob_n: 2
                KnobWidget:
                    knob_n: 3
                KnobWidget:
                    knob_n: 4
                KnobWidget:
                    knob_n: 5
                KnobWidget:
                    knob_n: 6
                KnobWidget:
                    knob_n: 7
                KnobWidget:
                    knob_n: 8

    # -- barra inferior: master, guardar/recargar y estado -------------------
    BoxLayout:
        size_hint_y: None
        height: 46
        spacing: 8
        Label:
            text: "Master"
            size_hint_x: None
            width: 60
            color: 0.8, 0.8, 0.8, 1
        ReleaseSlider:
            id: master
            min: 0
            max: 200
            value: 100
            on_release: app.on_master(int(self.value))
        Label:
            id: lbl_master
            text: str(int(master.value)) + "%"
            size_hint_x: None
            width: 50
            color: 0.5, 0.9, 0.55, 1
        Button:
            text: "Guardar"
            size_hint_x: None
            width: 100
            background_color: 0.2, 0.5, 0.3, 1
            on_release: app.guardar()
        Button:
            text: "Recargar"
            size_hint_x: None
            width: 100
            background_color: 0.25, 0.25, 0.28, 1
            on_release: app.recargar()
        Label:
            id: lbl_estado
            text: ""
            color: 0.75, 0.75, 0.75, 1
            halign: "left"
            valign: "middle"
            text_size: self.size
